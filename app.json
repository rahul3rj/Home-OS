{
  "expo": {
    "name": "Home Os",
    "slug": "home-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homeos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeos.app"
    },
    "android": {
      "package": "com.homeos.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#13482B",
        "foregroundImage": "./assets/android-icon-background.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101208",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#101208",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3d6bef8-4307-4513-9b9c-2b98fefc4abf"
      }
    },
    "owner": "rahul3rj"
  }
}
