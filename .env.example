# Copy this file to `.env` and fill in your values.
# `.env` is gitignored. NEVER commit real credentials.
#
# Everything here is EXPO_PUBLIC_*, which Expo inlines into the app bundle as
# PLAIN TEXT. Only put publishable values here.
#
# That is all this app needs. There is no Google client ID, no OAuth secret and
# no third-party account to set up.

# --- Supabase ---
# Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
